<mxfile host="app.diagrams.net"><diagram id="notion" name="Архитектура Notion"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" arrows="1" connect="1" page="1" pageScale="1" pageWidth="1400" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Обновлённая архитектура информационной системы Notion (лабораторная работа №2)&lt;/b&gt;&lt;br&gt;Сценарий: создание страницы и добавление блока" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;arcSize=10;fontSize=15;" vertex="1" parent="1"><mxGeometry x="170" y="0" width="930" height="45" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Пользователь&lt;/b&gt;&lt;br&gt;студент" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=10;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="90" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Браузер&lt;/b&gt; (Chrome / Edge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#9e9e9e;fontSize=12;arcSize=10;verticalAlign=top;dashed=1;" vertex="1" parent="1"><mxGeometry x="170" y="60" width="300" height="400" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Интерфейс (UI)&lt;/b&gt;&lt;br&gt;боковая панель, кнопка New page,&lt;br&gt;блочный редактор, slash-меню «/»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="100" width="260" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Клиентская часть (SPA, JavaScript)&lt;/b&gt;&lt;br&gt;ClientFramework.js, React-компоненты&lt;br&gt;генерация UUID, транзакции,&lt;br&gt;оптимистичное обновление" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="230" width="260" height="95" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Хранилище браузера&lt;/b&gt;&lt;br&gt;cookies, localStorage, IndexedDB (очередь),&lt;br&gt;кэш service worker (файлы приложения)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="370" width="260" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Cloudflare&lt;/b&gt;&lt;br&gt;CDN, HTTPS,&lt;br&gt;защита от DDoS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="235" width="130" height="75" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;app.notion.com/api/v3&lt;br&gt;saveTransactions*, syncRecordValues*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="190" height="75" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Сервер реального времени&lt;/b&gt;&lt;br&gt;msgstore-002.app.notion.com&lt;br&gt;WebSocket (Primus)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="335" width="190" height="75" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Сервер приложений&lt;/b&gt;&lt;br&gt;проверка прав, применение&lt;br&gt;транзакций, рассылка изменений&lt;br&gt;(ячейка prod-space-usw2, AWS*)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="225" width="190" height="95" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;База данных&lt;/b&gt;&lt;br&gt;PostgreSQL (шарды)*&lt;br&gt;таблицы block, notion_user, space" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;shape=cylinder3;boundedL