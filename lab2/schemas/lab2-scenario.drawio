        <mxCell id="e1" value="1. Enter в блоке To-do&lt;br&gt;(добавление блока)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.25;entryX=0;entryY=0.25;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1" source="user" target="browser">
