          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="3. отрисовка блока&lt;br&gt;(сразу, до ответа сервера)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0;exitY=0.75;entryX=1;entryY=0.75;verticalAlign=top;labelBackgroundColor=none;" edge="1" parent="1" source="frontend" target="browser">
